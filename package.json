{
  "name": "progressor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:sync-core": "tsc -p tsconfig.sync-core.json --noEmit",
    "check:sync-core": "node scripts/vendor-sync-core.mjs --check",
    "gate": "pnpm run typecheck && pnpm run typecheck:sync-core && pnpm run check:sync-core && pnpm test && pnpm run build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist --repo https://github.com/ChobanyanNarek/tracker.git",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^6.2.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.1.9"
  }
}
